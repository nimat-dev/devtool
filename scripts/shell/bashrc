# Read by interactive bash in the toolbox (from /etc/bash.bashrc, see the Dockerfile).
# zsh is the default shell and the full experience (grey suggestions as you type); bash gets
# the same aliases, Tab completion and a history that is kept between sessions.
# shellcheck shell=bash disable=SC1091
case $- in
  *i*) ;;
  *) return 0 ;;
esac

# History lives in ~ (the toolbox volume): shared by sessions, no duplicates.
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# Tab completion: bash-completion loads /usr/share/bash-completion/completions/<tool> on first use
# (kubectl, helm, flux, gh, kustomize, azd and az are put there when the image is built).
if ! shopt -oq posix && [ -r /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi

# az and terraform complete through their own protocols (kubectl, helm, flux ... load lazily above).
. /etc/devtools/az-completion.sh
if [ -x /usr/bin/terraform ]; then complete -C /usr/bin/terraform terraform tf; fi

. /etc/devtools/aliases.sh

# "k" completes like kubectl.
if declare -F _completion_loader > /dev/null; then
  _completion_loader kubectl 2> /dev/null
  if declare -F __start_kubectl > /dev/null; then complete -o default -F __start_kubectl k; fi
fi

# Your own shortcuts, read last so they win.
if [ -r "$HOME/.devtools-aliases.sh" ]; then . "$HOME/.devtools-aliases.sh"; fi

# Shortcuts such as kgp or azsubs: bash does not look inside an alias when it completes, so the
# words are put back the way the tool expects them ("kgp --all" becomes "kubectl get pods --all")
# and the tool's own completion answers. The ones that are the bare tool name (k, tf) are above.
_devtools_complete_alias() {
  local shortcut=${COMP_WORDS[0]} expansion
  expansion=${BASH_ALIASES[$shortcut]-}
  [ -n "$expansion" ] || return 0
  local -a spelled
  read -r -a spelled <<< "$expansion"
  local tool=${spelled[0]} spec
  if ! spec=$(complete -p "$tool" 2> /dev/null); then
    # Not loaded yet (helm, flux ...). Never when the tool already has one: the loader would
    # replace it with a minimal one.
    declare -F _completion_loader > /dev/null && _completion_loader "$tool" 2> /dev/null
    spec=$(complete -p "$tool" 2> /dev/null) || return 0
  fi

  # The words, the line and the cursor as bash would have had them if the shortcut had been spelled out.
  local -a words=("${spelled[@]}" "${COMP_WORDS[@]:1}")
  local lead=${COMP_LINE%%[![:space:]]*}
  local line="$lead$expansion${COMP_LINE#"$lead$shortcut"}"
  local point=$((COMP_POINT + ${#expansion} - ${#shortcut}))
  local cword=$((COMP_CWORD + ${#spelled[@]} - 1))
  local -a COMP_WORDS=("${words[@]}")
  local COMP_LINE=$line COMP_POINT=$point COMP_CWORD=$cword
  local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD - 1]}

  local how is_function=' -F ([A-Za-z0-9_.:-]+)' is_command=" -C '?([^' ]+)"
  if [[ $spec =~ $is_function ]]; then
    how=${BASH_REMATCH[1]}
    "$how" "$tool" "$cur" "$prev"
  elif [[ $spec =~ $is_command ]]; then
    how=${BASH_REMATCH[1]}
    local IFS=$'\n'
    # shellcheck disable=SC2207
    COMPREPLY=($(COMP_LINE="$COMP_LINE" COMP_POINT="$COMP_POINT" "$how" "$tool" "$cur" "$prev" 2> /dev/null))
  fi
}
for _devtools_name in "${!BASH_ALIASES[@]}"; do
  case ${BASH_ALIASES[$_devtools_name]} in
    "kubectl "* | "helm "* | "flux "* | "gh "* | "kustomize "* | "azd "* | "terraform "* | "az "*)
      complete -o default -F _devtools_complete_alias "$_devtools_name" ;;
  esac
done
unset _devtools_name
