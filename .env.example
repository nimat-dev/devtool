# Copy to .env and adjust.  docker compose reads this automatically.
#   cp .env.example .env   (PowerShell:  Copy-Item .env.example .env)

# --- Where your code lives -------------------------------------------------
# Absolute host path mounted at /repos inside the container.
# Leave unset to use the ./repos folder in this project.
# Windows example (note forward slashes work fine in .env):
# REPOS_ROOT=C:/Users/you/repos
REPOS_ROOT=

# --- Corporate proxy (leave blank if not behind one) -----------------------
# HTTP_PROXY=http://proxy.corp.example:8080
# HTTPS_PROXY=http://proxy.corp.example:8080
HTTP_PROXY=
HTTPS_PROXY=

# --- Pinned tool versions (binary/tarball installs) ------------------------
# Bump any of these and rebuild to upgrade that tool.
KUBECTL_VERSION=1.31.4
KUBELOGIN_VERSION=0.1.4
HELM_VERSION=3.16.3
KUSTOMIZE_VERSION=5.5.0
FLUX_VERSION=2.4.0
YQ_VERSION=4.44.6
GH_VERSION=2.63.2
KUBECTX_VERSION=0.9.5

# --- Floating tools (blank = latest at build time) -------------------------
# Set a value to pin. Examples shown commented.
# AZURE_CLI_VERSION=2.64.0
# TERRAFORM_VERSION=1.9.8
# AZD_VERSION=1.11.0
# AWSCLI_VERSION=2.17.0
AZURE_CLI_VERSION=
TERRAFORM_VERSION=
AZD_VERSION=
AWSCLI_VERSION=
